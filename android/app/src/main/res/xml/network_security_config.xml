<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is permitted only for localhost and 10.0.2.2 (emulator host alias).
  All other traffic, including the production API (api.yawmiyati.com), must use HTTPS.
  Do not add domain-config entries for production hosts.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
