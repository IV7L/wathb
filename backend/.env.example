# Wathb backend — environment variable template
# Copy this file to .env and fill in real values before running the server.
# NEVER commit .env to version control.

# Django core
DJANGO_SECRET_KEY=change-me-use-a-long-random-string-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_SETTINGS_MODULE=yawmiyati.settings.production

# PostgreSQL
DB_NAME=yawmiyati_prod
DB_USER=yawmiyati_user
DB_PASSWORD=change-me-strong-db-password
DB_HOST=localhost
DB_PORT=5432

# JWT token lifetimes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# File uploads
MEDIA_ROOT=media
MAX_UPLOAD_SIZE_BYTES=5242880

# CORS (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# Static files (production only)
STATIC_ROOT=staticfiles
